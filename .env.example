# Copia este archivo a .env y llena los valores reales. .env nunca se sube a git.

# Cadena de conexion a PostgreSQL. Formato:
# postgresql+psycopg://usuario:password@host:puerto/nombre_base
DATABASE_URL=postgresql+psycopg://aim8_dev:changeme@localhost:5432/aim8_dev

# Tenant fijo que usa la pantalla web mientras no exista login (ver 'make seed').
TENANT_SLUG=demo

# Carpeta local donde se guardan los audios subidos a mano.
RECORDINGS_DIR=./data/recordings

# API key de OpenAI (platform.openai.com), usada para transcribir (Whisper)
# y analizar (GPT-4o-mini) las llamadas.
OPENAI_API_KEY=

# Opcional: cambiar de modelo sin tocar codigo.
TRANSCRIPTION_MODEL=whisper-1
ANALYSIS_MODEL=gpt-4o-mini

# Firma las cookies de sesion del login. Genera la tuya, por ejemplo con:
# python -c "import os; print(os.urandom(32).hex())"
SECRET_KEY=
